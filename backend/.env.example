# Anthropic API key (leave as-is to use rule-based setups only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model used for trade ideas (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Allowed frontend origins, comma separated. Use your real frontend URL in production.
# Default "*" allows any origin (fine for local development only).
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5500

# Optional: SQLite file location (default: backend/trade_ideas.db). On Render, point this at a persistent disk.
# DATABASE_PATH=/var/data/trade_ideas.db

# Optional: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO
